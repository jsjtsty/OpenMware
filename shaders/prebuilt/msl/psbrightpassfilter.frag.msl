#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_ConstantBuffer
{
    float g_BrightLowLimit;
    float g_BrightPower;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_ConstantBuffer& ConstantBuffer [[buffer(0)]], texture2d<float> Texture0 [[texture(0)]], sampler Sampler_Tex0 [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(precise::max(Texture0.sample(Sampler_Tex0, in.in_var_TEXCOORD0).xyz - float3(ConstantBuffer.g_BrightLowLimit), float3(0.0)) * ConstantBuffer.g_BrightPower, 1.0);
    return out;
}

